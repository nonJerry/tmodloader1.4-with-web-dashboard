{
  "name": "@terraria-podman/control-frontend",
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:ci": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "pnpm test:e2e-safe && pnpm test:e2e-destructive",
    "test:e2e-safe": "playwright test --grep-invert @destructive",
    "test:e2e-destructive": "cross-env PLAYWRIGHT_HTML_OUTPUT_DIR=playwright-e2e-report playwright test --grep @destructive --workers=1 --project chromium",
    "test:e2e-ui": "playwright test --ui",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "sass": "^1.107.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-musl": "^1.2.16",
    "lightningcss-linux-x64-musl": "^1.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.92.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.6.1",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}